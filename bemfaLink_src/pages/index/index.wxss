/* pages/index/index.wxss —— 设备列表首页 */

.conn-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  width: fit-content;
}
.conn-bar.on { background: rgba(7, 193, 96, 0.12); color: #07c160; }
.conn-bar.off { background: rgba(138, 147, 163, 0.14); color: var(--text-2); }
.conn-bar .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.conn-bar.on .dot { background: #07c160; box-shadow: 0 0 10rpx #07c160; }
.conn-bar.off .dot { background: #b0b6c0; }

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  position: relative;
  width: 48.5%;
  height: 320rpx;
  box-sizing: border-box;
  padding: 28rpx 24rpx 24rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(20, 30, 50, 0.06);
}
.card.offline { opacity: 0.72; }
.card-glow {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}
/* 深色模式下降低卡片光晕强度（用 .page.dark 是因为真机 prefers-color-scheme 不可靠） */
.page.dark .card-glow { background: radial-gradient(circle, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0) 70%); }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon .ico { font-size: 44rpx; }
.status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.status.s-on { background: rgba(7, 193, 96, 0.14); color: #07c160; }
.status.s-off { background: rgba(138, 147, 163, 0.16); color: var(--text-2); }

.card.alert { box-shadow: 0 0 0 2rpx #ff4d4f, 0 8rpx 24rpx rgba(255, 77, 79, 0.18); }
.status-row { display: flex; align-items: center; gap: 12rpx; }
.alert-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 77, 79, 0.16);
  color: #ff4d4f;
  font-weight: 600;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.card-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-2);
  opacity: 0.75;
}
.card-type {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-2);
}
.card-value {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--text);
}
.card-time {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--text-2);
}

/* 灯光卡片：截图风格 */
.light-layout {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 100%;
  width: 100%;
}
.light-info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  flex: 1;
  min-width: 0;
}
.light-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.light-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.light-bulb-wrap {
  margin-top: auto;
  padding-bottom: 4rpx;
}
.light-bulb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 193, 7, 0.14);
  font-size: 48rpx;
}

.light-power {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg-2);
  box-shadow: 0 8rpx 28rpx rgba(20, 30, 50, 0.12);
  transition: transform 120ms ease;
}
.light-power:active { transform: scale(0.92); }
.light-power.disabled { opacity: 0.45; }
.light-power.on { background: rgba(7, 193, 96, 0.12); box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.22); }
.light-power.off { background: var(--card-bg-2); }

.power-symbol {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}
.power-stem {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 16rpx;
  border-radius: 6rpx;
  background: var(--text-2);
}
.power-ring {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid var(--text-2);
  border-top-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}
.light-power.on .power-stem { background: #07c160; }
.light-power.on .power-ring { border-color: #07c160; border-top-color: transparent; }

/* 空状态 */
.empty {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon { font-size: 96rpx; }
.empty-title { margin-top: 24rpx; font-size: 32rpx; font-weight: 600; color: var(--text); }
.empty-sub { margin-top: 10rpx; font-size: 26rpx; color: var(--text-2); }
.empty-btn {
  margin-top: 36rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
}

/* 悬浮添加按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom) + 40rpx);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160, #06a556);
  color: #fff;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(7, 193, 96, 0.4);
}

