<!-- pages/mine/mine.wxml —— 我的 -->
<view class="page {{themeClass}}">
  <view class="header">
    <view class="header-glow header-glow-a"></view>
    <view class="header-glow header-glow-b"></view>
    <view class="avatar">🔧</view>
    <view class="header-name">巴法云控制台</view>
    <view class="header-sub">IoT 设备管理平台</view>
  </view>

  <!-- 连接状态 -->
  <view class="status-card">
    <view class="status-left">
      <view class="status-title">MQTT 连接状态</view>
      <view class="status-desc">{{connected ? '已连接到 bemfa.com' : '未连接'}}</view>
    </view>
    <view class="chip {{connected ? 'on' : 'off'}}">
      <text class="chip-dot"></text>{{connected ? '已连接' : '未连接'}}
    </view>
  </view>

  <!-- 私钥配置 -->
  <view class="card-block">
    <view class="block-title">连接配置</view>
    <view class="field">
      <text class="field-label">私钥 (clientId)</text>
      <view class="field-val" bindtap="toggleShow">
        {{showUid ? uid : (maskedUid || '未配置')}}
        <text class="eye">{{showUid ? '🙈' : '👁'}}</text>
      </view>
    </view>
    <view class="uid-input-wrap" wx:if="{{showUid}}">
      <input class="uid-input" placeholder="粘贴你的巴法云私钥" value="{{uid}}" bindinput="onUid" />
    </view>
    <view class="row-btns">
      <view class="btn-ghost" bindtap="copyUid">复制私钥</view>
      <view class="btn-primary" bindtap="saveUid">保存并连接</view>
    </view>
    <view class="tip" bindtap="openDoc">服务器：wss://bemfa.com:9504/wss · 点击复制文档</view>
  </view>

  <!-- 其他 -->
  <view class="card-block">
    <view class="block-title">数据与缓存</view>
    <view class="cell danger" bindtap="clearCache">
      <text class="cell-name">清空本地缓存</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="footer">巴法云微信小程序 · 原生实现 MQTT 3.1.1</view>
</view>
