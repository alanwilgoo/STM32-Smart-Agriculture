/* pages/mine/mine.wxss —— 我的 */

.header {
  position: relative;
  border-radius: 32rpx;
  padding: 56rpx 32rpx 44rpx;
  text-align: center;
  overflow: hidden;
  background: linear-gradient(135deg, #5677fc, #722ed1);
  box-shadow: 0 12rpx 30rpx rgba(86, 119, 252, 0.3);
}
.header-glow {
  position: absolute; width: 240rpx; height: 240rpx; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0) 70%);
}
.header-glow-a { top: -90rpx; left: -50rpx; }
.header-glow-b { bottom: -110rpx; right: -50rpx; }
.avatar {
  position: relative;
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  margin: 0 auto;
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx;
}
.header-name { position: relative; margin-top: 20rpx; font-size: 38rpx; font-weight: 700; color: #fff; }
.header-sub { position: relative; margin-top: 6rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.85); }

/* 连接状态卡 */
.status-card {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 28rpx;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  background: var(--card-bg);
  box-shadow: 0 6rpx 18rpx rgba(20, 30, 50, 0.05);
}
.status-title { font-size: 28rpx; font-weight: 600; color: var(--text); }
.status-desc { margin-top: 6rpx; font-size: 24rpx; color: var(--text-2); }
.chip {
  display: flex; align-items: center;
  font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 999rpx;
}
.chip.on { background: rgba(7, 193, 96, 0.14); color: #07c160; }
.chip.off { background: rgba(138, 147, 163, 0.16); color: var(--text-2); }
.chip-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 10rpx; }
.chip.on .chip-dot { background: #07c160; box-shadow: 0 0 10rpx #07c160; }
.chip.off .chip-dot { background: #b0b6c0; }

/* 配置块 */
.card-block {
  margin-top: 28rpx;
  border-radius: 24rpx;
  padding: 8rpx 28rpx 28rpx;
  background: var(--card-bg);
  box-shadow: 0 6rpx 18rpx rgba(20, 30, 50, 0.05);
}
.block-title { font-size: 26rpx; color: var(--text-2); padding: 24rpx 0 12rpx; }
.field { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.field-label { width: 220rpx; font-size: 28rpx; color: var(--text-2); }
.field-val { flex: 1; font-size: 28rpx; color: var(--text); display: flex; align-items: center; justify-content: space-between; }
.eye { font-size: 28rpx; }
.uid-input-wrap { padding: 16rpx 0; }
.uid-input {
  width: 100%; box-sizing: border-box;
  min-height: 84rpx;
  line-height: 44rpx;
  background: var(--card-bg-2); border-radius: 16rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: var(--text);
}
.row-btns { display: flex; margin-top: 24rpx; }
.btn-ghost, .btn-primary {
  flex: 1; text-align: center; padding: 22rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 600;
}
.btn-ghost { background: var(--card-bg-2); color: var(--text-2); margin-right: 20rpx; }
.btn-primary { background: var(--primary); color: #fff; }
.tip { margin-top: 20rpx; font-size: 22rpx; color: var(--text-2); word-break: break-all; }

/* 单元格 */
.cell {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 0; border-bottom: 2rpx solid var(--line);
}
.cell:last-child { border-bottom: none; }
.cell-name { font-size: 28rpx; color: var(--text); }
.cell.danger .cell-name { color: #f5222d; }
.cell-arrow { font-size: 36rpx; color: var(--text-2); }

.footer { margin-top: 48rpx; text-align: center; font-size: 22rpx; color: var(--text-2); }
