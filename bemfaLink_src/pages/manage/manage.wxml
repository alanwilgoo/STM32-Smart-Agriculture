<!-- pages/manage/manage.wxml —— 设备管理 -->
<view class="page {{themeClass}}">
  <!-- 统计概览 -->
  <view class="stat-card">
    <view class="stat-glow stat-glow-a"></view>
    <view class="stat-glow stat-glow-b"></view>
    <view class="stat-item">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-label">设备总数</view>
    </view>
    <view class="stat-item">
      <view class="stat-num on">{{stats.online}}</view>
      <view class="stat-label">在线设备</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.total - stats.online}}</view>
      <view class="stat-label">离线设备</view>
    </view>
  </view>

  <view class="section-title">设备列表</view>

  <view wx:if="{{devices.length === 0}}" class="list-empty">暂无设备，点击下方按钮添加</view>

  <view class="list">
    <view wx:for="{{devices}}" wx:key="id" class="list-item">
      <view class="list-icon icon-{{item.type}}">
        <text class="ico">{{item.emoji}}</text>
      </view>
      <view class="list-info">
        <view class="list-name">{{item.displayName}}</view>
        <view class="list-sub" wx:if="{{item.hasRemark}}">主题：{{item.name}}</view>
        <view class="list-sub">{{item.typeText}} · {{item.online ? '在线' : '离线'}}</view>
      </view>
      <view class="list-ops">
        <view class="op-edit" data-id="{{item.id}}" catchtap="editDevice">编辑</view>
        <view class="op-del" data-id="{{item.id}}" catchtap="deleteDevice">删除</view>
      </view>
    </view>
  </view>

  <view class="add-btn" bindtap="showAdd">＋ 添加设备</view>
</view>

<!-- 添加/编辑表单弹层 -->
<view wx:if="{{showForm}}" class="mask" bindtap="hideForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{editingId ? '编辑设备' : '添加设备'}}</view>
    <view class="field">
      <text class="field-label">设备名称</text>
      <input class="field-input" placeholder="如 客厅灯 / 温室传感器" value="{{form.name}}" bindinput="onName" />
    </view>
    <view class="field">
      <text class="field-label">设备类型</text>
      <picker class="field-picker" range="{{typeLabels}}" value="{{form.typeIndex}}" bindchange="onType">
        <view class="picker-val">{{typeLabels[form.typeIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">备注</text>
      <input class="field-input" placeholder="选填，如 客厅温湿度" value="{{form.remark}}" bindinput="onRemark" />
    </view>
    <view class="sheet-actions">
      <view class="act-cancel" bindtap="hideForm">取消</view>
      <view class="act-save" bindtap="saveDevice">保存</view>
    </view>
  </view>
</view>
