/* pages/manage/manage.wxss —— 设备管理 */

/* 统计卡 */
.stat-card {
  position: relative;
  display: flex;
  border-radius: 28rpx;
  padding: 36rpx 16rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #07c160, #06a556);
  box-shadow: 0 12rpx 30rpx rgba(7, 193, 96, 0.3);
}
.stat-glow {
  position: absolute; width: 220rpx; height: 220rpx; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0) 70%);
}
.stat-glow-a { top: -90rpx; left: -40rpx; }
.stat-glow-b { bottom: -110rpx; right: -40rpx; }
.stat-item { flex: 1; text-align: center; color: #fff; position: relative; }
.stat-num { font-size: 52rpx; font-weight: 800; }
.stat-num.on { color: #fff; }
.stat-label { margin-top: 6rpx; font-size: 24rpx; opacity: 0.9; }

.section-title { margin: 36rpx 8rpx 16rpx; font-size: 28rpx; color: var(--text-2); }
.list-empty { text-align: center; color: var(--text-2); padding: 60rpx 0; font-size: 26rpx; }

.list { display: flex; flex-direction: column; }
.list-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--card-bg);
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(20, 30, 50, 0.05);
}
.list-icon {
  width: 76rpx; height: 76rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.list-icon .ico { font-size: 40rpx; }
.list-info { flex: 1; margin-left: 22rpx; }
.list-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.list-sub { margin-top: 4rpx; font-size: 24rpx; color: var(--text-2); }
.list-ops { display: flex; }
.op-edit, .op-del {
  font-size: 26rpx; padding: 10rpx 22rpx; border-radius: 999rpx; margin-left: 12rpx;
}
.op-edit { background: rgba(86, 119, 252, 0.12); color: #5677fc; }
.op-del { background: rgba(245, 34, 45, 0.12); color: #f5222d; }

.add-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--card-bg);
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(20, 30, 50, 0.05);
  border: 2rpx dashed rgba(7, 193, 96, 0.4);
}

/* 弹层 */
.mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.45);
  display: flex; align-items: flex-end; z-index: 100;
}
.sheet {
  width: 100%;
  background: var(--card-bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title { font-size: 34rpx; font-weight: 700; color: var(--text); text-align: center; margin-bottom: 28rpx; }
.field { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.field-label { width: 160rpx; font-size: 28rpx; color: var(--text-2); }
.field-input { flex: 1; font-size: 30rpx; color: var(--text); }
.field-picker { flex: 1; }
.picker-val { font-size: 30rpx; color: var(--text); }
.sheet-actions { display: flex; margin-top: 36rpx; }
.act-cancel, .act-save {
  flex: 1; text-align: center; padding: 24rpx; border-radius: 999rpx; font-size: 30rpx; font-weight: 600;
}
.act-cancel { background: var(--card-bg-2); color: var(--text-2); margin-right: 20rpx; }
.act-save { background: var(--primary); color: #fff; }
