/* pages/detail/detail.wxss —— 单设备详情 */

.hero {
  position: relative;
  border-radius: 32rpx;
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  overflow: hidden;
  background: var(--card-bg);
  box-shadow: 0 10rpx 30rpx rgba(20, 30, 50, 0.08);
}
.hero.type-light.is-on {
  background: radial-gradient(circle at 50% 0%, rgba(250, 173, 20, 0.35), var(--card-bg) 70%);
}
.hero-glow {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  pointer-events: none;
}
.hero-glow-a { top: -120rpx; left: -60rpx; background: radial-gradient(circle, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0) 70%); }
.hero-glow-b { bottom: -140rpx; right: -60rpx; background: radial-gradient(circle, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 70%); }
/* 深色模式降低光晕（真机 prefers-color-scheme 不可靠，用 .page.dark） */
.page.dark .hero-glow-a { background: radial-gradient(circle, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0) 70%); }
.page.dark .hero-glow-b { background: radial-gradient(circle, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 70%); }

.hero-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-icon .ico { font-size: 72rpx; }
.hero-name { margin-top: 24rpx; font-size: 40rpx; font-weight: 700; color: var(--text); }
.hero-status { margin-top: 12rpx; font-size: 24rpx; display: inline-block; padding: 4rpx 18rpx; border-radius: 999rpx; }
.hero-status.s-on { background: rgba(7, 193, 96, 0.14); color: #07c160; }
.hero-status.s-off { background: rgba(138, 147, 163, 0.16); color: var(--text-2); }
.hero-type { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }

/* 灯开关 */
.light-panel {
  margin-top: 32rpx;
  border-radius: 32rpx;
  background: var(--card-bg);
  padding: 56rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(20, 30, 50, 0.08);
}
.switch-track {
  width: 200rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: #d8dde6;
  position: relative;
  transition: background 0.3s;
}
.switch-track.on { background: linear-gradient(135deg, #ffc53d, #fa8c16); }
.switch-thumb {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: left 0.3s;
}
.switch-track.on .switch-thumb { left: 104rpx; }
.switch-label { margin-top: 28rpx; font-size: 36rpx; font-weight: 700; color: var(--text); }
.switch-tip { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }

/* 温湿度双数据 */
.data-row {
  margin-top: 32rpx;
  display: flex;
  justify-content: space-between;
}
.data-cell {
  position: relative;
  width: 48.5%;
  border-radius: 32rpx;
  padding: 44rpx 24rpx;
  text-align: center;
  overflow: hidden;
  background: var(--card-bg);
  box-shadow: 0 10rpx 30rpx rgba(20, 30, 50, 0.08);
}
.data-cell.t { background: linear-gradient(160deg, rgba(19, 194, 194, 0.16), var(--card-bg) 70%); }
.data-cell.h { background: linear-gradient(160deg, rgba(82, 196, 26, 0.16), var(--card-bg) 70%); }
.data-glow {
  position: absolute; top: -40rpx; left: -40rpx;
  width: 160rpx; height: 160rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0) 70%);
}
.data-num { position: relative; font-size: 84rpx; font-weight: 800; color: var(--text); }
.data-cell.t .data-num { color: #13c2c2; }
.data-cell.h .data-num { color: #52c41a; }
.data-unit { position: relative; margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }

/* 单值 */
.single {
  position: relative;
  margin-top: 32rpx;
  border-radius: 32rpx;
  padding: 72rpx 32rpx;
  text-align: center;
  overflow: hidden;
  background: var(--card-bg);
  box-shadow: 0 10rpx 30rpx rgba(20, 30, 50, 0.08);
}
.single-glow {
  position: absolute; width: 240rpx; height: 240rpx; border-radius: 50%; pointer-events: none;
}
.single-glow-a { top: -100rpx; left: -50rpx; background: radial-gradient(circle, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0) 70%); }
.single-glow-b { bottom: -120rpx; right: -50rpx; background: radial-gradient(circle, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 70%); }
.page.dark .single-glow-a, .page.dark .single-glow-b { background: radial-gradient(circle, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 70%); }
.single-num { position: relative; font-size: 110rpx; font-weight: 800; color: var(--text); letter-spacing: 2rpx; }
.single-unit { position: relative; margin-top: 8rpx; font-size: 28rpx; color: var(--text-2); }

/* 趋势折线图 */
.chart-card {
  margin-top: 32rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  padding: 28rpx 24rpx 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(20, 30, 50, 0.08);
}
.chart-head { display: flex; align-items: center; justify-content: space-between; }
.chart-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.chart-range { display: flex; background: rgba(140, 150, 170, 0.12); border-radius: 999rpx; padding: 4rpx; }
.range-btn {
  font-size: 22rpx;
  color: var(--text-2);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  line-height: 1;
}
.range-btn.on { background: #3b82f6; color: #fff; font-weight: 600; }
.chart-legend { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.legend-item { display: flex; align-items: center; margin-right: 28rpx; margin-bottom: 6rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 4rpx; margin-right: 10rpx; }
.legend-name { font-size: 22rpx; color: var(--text-2); }
.chart-canvas { width: 100%; height: 420rpx; display: block; margin-top: 8rpx; }
.chart-hint { margin-top: 12rpx; text-align: center; font-size: 22rpx; color: var(--text-2); }
.chart-foot { margin-top: 6rpx; text-align: center; font-size: 20rpx; color: var(--text-2); }

/* 元信息 */
.meta { margin-top: 32rpx; border-radius: 24rpx; background: var(--card-bg); padding: 24rpx 28rpx; }
.meta-row { display: flex; justify-content: space-between; padding: 14rpx 0; font-size: 26rpx; }
.meta-k { color: var(--text-2); }
.meta-v { color: var(--text); max-width: 60%; text-align: right; word-break: break-all; }

/* 越限告警横幅 */
.alert-banner {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 77, 79, 0.12);
  border: 1rpx solid rgba(255, 77, 79, 0.35);
}
.alert-ico { font-size: 32rpx; margin-right: 12rpx; }
.alert-text { flex: 1; font-size: 26rpx; color: #ff4d4f; line-height: 1.4; }

/* 告警阈值配置卡片 */
.alert-card { margin-top: 24rpx; border-radius: 24rpx; background: var(--card-bg); padding: 24rpx 28rpx; box-shadow: 0 10rpx 30rpx rgba(20, 30, 50, 0.08); }
.ac-head { display: flex; align-items: center; justify-content: space-between; }
.ac-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.ac-tip { margin-top: 14rpx; font-size: 24rpx; color: var(--text-2); }
.ac-row { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.ac-label { font-size: 26rpx; color: var(--text); }
.ac-input {
  width: 240rpx;
  text-align: right;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: var(--input-bg, rgba(140, 150, 170, 0.12));
  color: var(--text);
  font-size: 26rpx;
}
.ac-note { margin-top: 18rpx; font-size: 22rpx; color: var(--text-2); line-height: 1.5; }

.empty { margin-top: 200rpx; text-align: center; color: var(--text-2); }
